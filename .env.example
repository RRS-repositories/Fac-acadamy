# FAC Academy environment. PLACEHOLDERS ONLY: copy to .env and fill in locally.
# Never commit .env. The app refuses to start if a required variable is missing.
# Local values point at the docker-compose services. Anything secret is `change-me`.

# --- Server -----------------------------------------------------------------
PORT=4100
HOST=127.0.0.1
# Public origin of the academy (used in links in emails and certificates).
PUBLIC_BASE_URL=http://localhost:5173

# --- Feature flags (production defaults are OFF) -----------------------------
# Local dev may set ACADEMY_V2=true. Production stays false until Brad signs off.
ACADEMY_V2=false
# false = provisioning runs in shadow mode (logs only).
ACADEMY_PROVISIONING=false
STAGE1_AUTH_REQUIRED=false
AUTH_STRICT=true

# --- Database: Postgres, schema `academy` -----------------------------------
# Same variable names as the CRM (DB_HOST, DB_PORT, DB_NAME, DB_USER, DB_PASSWORD, DB_SSL).
# Production: the CRM's own database (Postgres 17), schema `academy`, login role academy_app.
# DB_NAME is REQUIRED and set explicitly: never rely on the PG* defaults. On the
# production box they belong to a different app's database.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=academy_dev
DB_USER=academy_app
DB_PASSWORD=change-me
# true in production (the CRM connects with SSL); false for a local Postgres.
DB_SSL=false
# Migrations run as an owner/admin login, not academy_app. In production Brad runs
# them with his own admin login. Locally: academy_owner (ops/local/setup-local-db.mjs).
MIGRATE_DB_USER=academy_owner
MIGRATE_DB_PASSWORD=change-me
# Local/CI only: the throw-away database the migration tests may wipe.
MIGRATION_TEST_DB_NAME=

# --- Redis: sessions + BullMQ (prefix "academy") ----------------------------
REDIS_URL=redis://localhost:6379

# --- Sessions ---------------------------------------------------------------
# Long random string, at least 32 characters. The placeholder is deliberately too short,
# so the app refuses to start until you set a real one, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=change-me

# --- CRM API (academy-verify; create-user + setup-token from S08) -----------
CRM_AUTH_URL=http://localhost:3000/api/auth/academy-verify
CRM_AUTH_KEY=change-me
# CRM origin used in the password-setup email link.
CRM_PUBLIC_URL=http://localhost:3000

# --- S3 (media + certificates, private bucket) ------------------------------
S3_BUCKET=academy-local
S3_REGION=eu-west-2
# Local only: MinIO endpoint. Leave blank in production (real S3).
S3_ENDPOINT=http://localhost:9000
# true for MinIO, false for real S3.
S3_FORCE_PATH_STYLE=true
# Local MinIO credentials from docker-compose. Production uses the server's AWS credentials.
AWS_ACCESS_KEY_ID=academy-local
AWS_SECRET_ACCESS_KEY=academy_local_only

# --- Email (SES in production, Mailpit locally) ------------------------------
SES_REGION=eu-west-2
SES_SENDER=academy@example.com
# Dev only: send through Mailpit instead of SES. Leave blank in production.
SMTP_URL=smtp://localhost:1025

# --- Mattermost (provisioning approvals + manager alerts) --------------------
MATTERMOST_URL=http://localhost:8065
MATTERMOST_BOT_TOKEN=change-me
MATTERMOST_IT_CHANNEL_ID=change-me
# Comma-separated Mattermost usernames allowed to approve new starters.
PROVISIONING_RESPONDERS=change-me

# --- Ops scripts only (never read by the app) --------------------------------
# Absolute path to the prototype HTML. MUST be OUTSIDE this repo: it embeds real
# client recordings and staff details. The ops scripts refuse a path inside the repo.
PROTOTYPE_PATH=/path/outside/the/repo/FAC-Academy-Portal-v2.5.html
