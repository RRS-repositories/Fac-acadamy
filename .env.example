# FAC Academy environment. PLACEHOLDERS ONLY: copy to .env and fill in locally.
# Never commit .env. The app refuses to start if a required variable is missing.
# Local values point at the docker-compose services. Anything secret is `change-me`.

# --- Server -----------------------------------------------------------------
# NODE_ENV IS NOT DECORATION. Leave it out and the app runs in DEVELOPMENT mode
# — on a live server that means the session cookie is NOT marked secure (it is
# sent over plain http and is stealable), the mock CRM would be allowed, Redis
# stops being required, and http:// URLs are accepted. Nothing warns you: the
# app starts perfectly and the log line says NODE_ENV=development in the middle
# of a sentence nobody reads.
#
#   development   a laptop (the default when this is unset)
#   test          the automated tests
#   production    the real server. Set it there, in the .env AND in pm2's env.
NODE_ENV=development
PORT=4100
HOST=127.0.0.1
# Public origin of the academy. It is what every certificate's /verify/<id> link
# is built from, so a wrong value cannot be corrected after a certificate has
# been issued and emailed. Must start with https:// when NODE_ENV=production.
PUBLIC_BASE_URL=http://localhost:5173

# --- Feature flags (production defaults are OFF) -----------------------------
# Local dev may set ACADEMY_V2=true. Production stays false until Brad signs off.
ACADEMY_V2=false
# false = provisioning runs in shadow mode (logs only).
ACADEMY_PROVISIONING=false
# true = nobody gets past their first stage until a manager authorises them.
# THERE IS NO SCREEN FOR THIS. The only supported way to authorise someone (or
# take it back) is the audited ops command:
#   npx tsx ops/admin/authorise-stage1.ts --email <email> --by <name> \
#       --expect-db <database> [--dry-run] [--revoke]
# Turn this on without a plan for running that command and every trainee stops
# dead after stage 1 with nothing in the app to unblock them.
STAGE1_AUTH_REQUIRED=false

# --- Database: Postgres, schema `academy` -----------------------------------
# Same variable names as the CRM (DB_HOST, DB_PORT, DB_NAME, DB_USER, DB_PASSWORD, DB_SSL).
# Production: the CRM's own database (Postgres 17), schema `academy`, login role academy_app.
# DB_NAME is REQUIRED and set explicitly: never rely on the PG* defaults. On the
# production box they belong to a different app's database.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=academy_dev
DB_USER=academy_app
# At least 12 characters, and generated rather than chosen — nobody types this
# one. The placeholder is deliberately too short, so the app refuses to start
# until you set a real one:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
DB_PASSWORD=change-me
# true in production (the CRM connects with SSL); false for a local Postgres.
DB_SSL=false
# Migrations run as an owner/admin login, not academy_app. In production Brad runs
# them with his own admin login. Locally: academy_owner (ops/local/setup-local-db.mjs).
MIGRATE_DB_USER=academy_owner
MIGRATE_DB_PASSWORD=change-me
# Local/CI only: the database the DB-backed tests run against.
MIGRATION_TEST_DB_NAME=
# Local/CI only: a SEPARATE throw-away database for the migration tests; they drop
# the academy schema, so sharing one would wipe the seeded content.
MIGRATIONS_TEST_DB_NAME=

# --- Redis: sessions + BullMQ (prefix "academy") ----------------------------
# Required in production. Without it the API keeps sessions and rate limits in
# memory (so a restart signs everyone out) and the worker refuses to start.
REDIS_URL=redis://localhost:6379

# --- Sessions ---------------------------------------------------------------
# true = the session cookie is only sent over HTTPS. Defaults to true when
# NODE_ENV=production, false elsewhere; set it only to override that.
COOKIE_SECURE=false

# --- MFA (TOTP) ---------------------------------------------------------------
# Encrypts every trainee's authenticator secret in the database. base64 of 32
# random bytes; generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it safe and never change it casually: if it is lost or changed, the stored
# secrets cannot be read and EVERYONE has to set up their authenticator again.
MFA_ENCRYPTION_KEY=change-me

# --- CRM API (academy-verify) -----------------------------------------------
# http = call the CRM's academy-verify endpoint (production).
# mock = a built-in fake CRM for local development only; the app refuses to
# start with mock in production.
CRM_AUTH_MODE=http
# Must start with https:// when NODE_ENV=production: every sign-in sends a
# trainee's CRM password and the shared key over this URL.
CRM_AUTH_URL=http://localhost:3000/api/auth/academy-verify
# Shared key the academy sends to the CRM. Must be the SAME value as the CRM's
# ACADEMY_VERIFY_KEY, at least 32 characters.
CRM_AUTH_KEY=change-me

# --- Media: on the server's own disk, NOT S3 (decision D15, 23 Sep) ---------
# Every call recording and the FOS video live in this folder. The API streams
# each byte itself, after checking the session and the stage lock, so there are
# no signed URLs and nothing here is ever fetched directly by a browser.
# Must be an ABSOLUTE path, or the app refuses to start.
#
#   Local:      ./.media relative to this repo, gitignored. Write it as an
#               absolute path, e.g. /home/you/fac-academy/.media, or on Windows
#               with FORWARD slashes: E:/RRC/fac-academy/.media
#   Production: a folder owned by the application user, OUTSIDE the website
#               folder, so nginx cannot serve it. Back it up: from now on the
#               database alone does not hold the media.
MEDIA_ROOT=/path/to/fac-academy/.media
# Ceiling for a manager's upload, in megabytes. Streaming is unaffected.
# nginx's client_max_body_size must be at least this (ops/nginx/), and a
# Cloudflare tunnel caps a request body around 100 MB whatever either of them
# says — anything bigger goes in with ops/media/ingest-media.ts on the server.
MEDIA_MAX_UPLOAD_MB=200

# --- Notifications and email (S08) -------------------------------------------
# No email provider has been chosen yet (D18: Mattermost dropped 23 Sep 2026;
# D19: no AWS, so no SES — the CRM uses Microsoft 365/Graph and SMTP), so
# notifications run in SHADOW mode: composed, recorded in audit_events, logged,
# never sent.
#   shadow  compose + audit row + one log line (the default, and the safe one)
#   log     one log line only, no audit row
#   off     nothing at all
# There is deliberately no 'send' until a provider exists and Brad signs it off.
ACADEMY_NOTIFY_MODE=shadow
# Reserved for that provider: nothing reads it yet. Locally it is where a Mailpit
# would go. Leave blank in production.
SMTP_URL=

# --- Ops scripts only (never read by the app) --------------------------------
# Absolute path to the prototype HTML. On Windows use FORWARD slashes (a
# backslash is read as an escape here). MUST be OUTSIDE this repo: it embeds real
# client recordings and staff details. The ops scripts refuse a path inside the repo.
PROTOTYPE_PATH=/path/outside/the/repo/FAC-Academy-Portal-v2.5.html

# Backup and restore drill (ops/backup/, docs/RUNBOOK-BACKUP.md). Only the
# backup scripts read these; the API and the worker never do.
# The login that reads for a backup and writes during a restore drill. It falls
# back to MIGRATE_DB_USER/MIGRATE_DB_PASSWORD, then DB_USER/DB_PASSWORD — but
# academy_app cannot create the drill's scratch database, so set these.
BACKUP_DB_USER=
BACKUP_DB_PASSWORD=
# Leave the rest blank unless the backup runs against a different server:
# BACKUP_DB_HOST, BACKUP_DB_PORT, BACKUP_DB_NAME and BACKUP_DB_SSL each
# override the DB_* setting of the same name for the backup scripts only.
# Where PostgreSQL's own tools (pg_dump, pg_restore, psql) live, if they are not
# already on the PATH. On Windows, e.g. C:/Program Files/PostgreSQL/17/bin
PG_BIN=
# The database the restore drill connects to in order to create and drop its
# throw-away copy. Normally the server's default database.
BACKUP_MAINTENANCE_DB=postgres
