{
  "name": "@fac-academy/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "FAC Academy API and background worker",
  "scripts": {
    "dev": "tsx watch src/entry/api.ts",
    "dev:worker": "tsx watch src/entry/worker.ts",
    "build": "tsup",
    "start": "node dist/api.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "migrate": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "@fac-academy/shared": "*",
    "express": "^5.1.0",
    "ioredis": "^6.0.0",
    "music-metadata": "^11.2.0",
    "pg": "^8.23.0",
    "zod": "^3.24.0",
    "otplib": "^12.0.1",
    "qrcode": "^1.5.4",
    "rate-limiter-flexible": "^5.0.3",
    "cookie-parser": "^1.4.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "vitest": "^3.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/cookie-parser": "^1.4.8"
  }
}
